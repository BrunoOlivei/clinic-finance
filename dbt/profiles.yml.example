clinic_finance:
  target: dev
  outputs:
    dev:
      type: duckdb
      path: "{{ env_var('WAREHOUSE_PATH', '../data/warehouse.duckdb') }}"
      threads: 4
      plugins:
        - module: delta
        - module: dbt_plugins.postgres_attach
          config:
            dsn: "{{ env_var('POSTGRES_DSN', 'postgresql://clinic:clinic@localhost:5432/clinic_finance') }}"
            duckdb_alias: gold_pg
