# App
ENVIRONMENT=dev
LOG_LEVEL=INFO

# URLs do SAVI
URL_LOGIN = "https://saviatendimento.com.br/saviatendimento/login.faces"
URL_PRODUCAO = "https://saviatendimento.com.br/saviatendimento/pages/relatorio/relatorio_producao.faces"
URL_SOLICITACOES = "https://saviatendimento.com.br/saviatendimento/pages/solicitacao/solicitacoes_em_aberto.faces"
URL_PENDENCIAS = "https://saviatendimento.com.br/saviatendimento/pages/relatorio/relatorio_pendencia.faces"

# Login
FIELD_USERNAME = '[name="login_form:username"]'
FIELD_PASSWORD = '[name="login_form:password"]'

USERNAME =
PASSWORD =

# Production form selectors
SEL_MES = '[name="formulario:medico"]'
SEL_DIA_DE = '[name="formulario:j_idt95"]'
SEL_DIA_ATE = '[name="formulario:j_idt97"]'
SEL_PESQUISAR = '[name="formulario:j_idt99"]'

# Pending report form selectors
# IMPORTANT: JSF IDs (j_idt*) are server-generated and may change after a SAVI
# update. Verify every selector below by inspecting the live page before running.
PEND_SEL_USER_CODE = '[name="formulario:codigo_beneficiario"]'
PEND_SEL_SEARCH_USER = '[name="formulario:j_idt85"]'
PEND_SEL_MES = '[name="formulario:medico"]'
PEND_SEL_SITUACAO = '[name="formulario:situacaoSelecao"]'
PEND_SEL_PESQUISAR = '[name="formulario:j_idt102"]'

PEND_SEL_PAGINATION = '[id="formulario:pendenciasNovoProcesso_rppDD"]'
PEND_SEL_TOTAL = '[class="ui-paginator-current"]'
PEND_EXEC_PENDENTE = '[name="formulario:pendenciasNovoProcesso:0:linkExplicacaoStatus2"]'

USER_DATA_DIR = "./user-data"
BRONZE_DIR = "./data/bronze"
WAREHOUSE_PATH = "./data/warehouse.duckdb"

# Camada gold (PostgreSQL) — serviço "db" do docker-compose no devcontainer.
# Fora do devcontainer, use localhost (porta publicada pelo compose).
POSTGRES_DSN = "postgresql://clinic:clinic@localhost:5432/clinic_finance"
